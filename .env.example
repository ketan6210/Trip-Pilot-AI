DATABASE_URL=postgresql+psycopg://trippilot:trippilot@127.0.0.1:5433/trippilot
# For an isolated SQLite development database instead: sqlite:///./trippilot.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Use true behind HTTPS in production. Local HTTP needs false.
COOKIE_SECURE=false
SESSION_HOURS=24
AUTH_RATE_LIMIT=20
PROVIDER_ATTEMPTS=3
ROUTE_CACHE_SECONDS=900
# auto uses HF when HF_TOKEN is present, otherwise the local Ollama model.
# Use huggingface to require HF explicitly (no silent local model substitution).
ORCHESTRATOR_PROVIDER=auto
HF_TOKEN=
HF_MODEL=Qwen/Qwen3-32B:deepinfra
# Hosted inference uses HF monthly credits, then requires paid credits.
# A free HF account currently includes $0.10/month; no unlimited free API.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Containers reach a model running on the host through this separate address.
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_SECONDS=120
# Shared structured-call timeout; Phase 2 adapters use this setting.
LLM_TIMEOUT_SECONDS=30
LLM_CORRECTION_ATTEMPTS=2
# Leave blank for unknown cost. Set both to your provider's actual USD/M-token rates.
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
AI_SOLVER_SECONDS=3
AI_CANDIDATE_LIMIT=40
# Default: deterministic concept-expanded vectors. Optional sentence_transformers
# requires its separate dependency and model weights; it is loaded lazily.
EMBEDDING_BACKEND=concept_hash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
PLACE_PROVIDER=live
CITY_SEARCH_URL=https://geocoding-api.open-meteo.com/v1/search
PLACE_CACHE_HOURS=24
LIVE_DATA_TIMEOUT_SECONDS=30
TRIPPILOT_USER_AGENT=TripPilotAI/0.2 (http://127.0.0.1:5173; local development)
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_FALLBACK_URL=https://overpass.private.coffee/api/interpreter
# Optional official Google Maps Platform key. Enable Places API (New) for
# ratings/phone numbers and Routes API for live route times/transit fares.
# Google requires billing for these APIs; without a key TripPilot keeps the
# fields unavailable and uses clearly labeled local transport estimates.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACE_CACHE_DAYS=30
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
SKYSCANNER_API_KEY=
# Official Skyscanner Partner Live Prices API. If neither this nor production
# Amadeus credentials are set, flight prices remain unavailable (never mocked).
FLIGHT_CACHE_MINUTES=15
AMADEUS_BASE_URL=https://api.amadeus.com
FLIGHT_LOCATION_URL=https://autocomplete.travelpayouts.com/places2
PREFERENCE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
PREFERENCE_HIGH_SIMILARITY=0.52
PREFERENCE_MEDIUM_SIMILARITY=0.20
